{
  "name": "element-juggler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:play": "tsc --noEmit && vite build --mode play && node -e \"require('fs').copyFileSync('.play-build/index.html','play.html')\""
  },
  "dependencies": {
    "galmuri": "^2.40.3",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
